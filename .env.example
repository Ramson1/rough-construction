# --- Public (browser) configuration ---
# Dev discovery broker. Swap for a private broker before production.
NEXT_PUBLIC_MQTT_URL=wss://test.mosquitto.org:8081
NEXT_PUBLIC_MQTT_TOPIC=blackbox_tech_baseplate_servers_2026

# Toggle the Next.js server registry as a second discovery source.
NEXT_PUBLIC_ENABLE_BACKEND_DISCOVERY=true

# Comma-separated STUN/TURN URLs for WebRTC. Add TURN for production NAT traversal.
NEXT_PUBLIC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Server-side configuration (backend seam) ---
# Plug Neon / PostgreSQL / Supabase in lib/server-registry.ts when ready.
DATABASE_URL=
